<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_linkattacher</name>
  <version>0.0.0</version>
  <description>IFRA-Cranfield LinkAttacher plugin ported to Gazebo Harmonic (gz-sim 8)</description>

  <author>Mikel Bueno Viso</author>
  <maintainer email="Mikel.Bueno-Viso@cranfield.ac.uk">Mikel Bueno Viso</maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <build_depend>linkattacher_msgs</build_depend>

  <!-- Gazebo Harmonic; rosdep key varies by distro — gz-sim is provided by
       the ros-jazzy-ros-gz meta-package so no explicit rosdep entry needed. -->
  <depend>gz_sim_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>